# Sobe e derruba o peculio inteiro via podman-compose, como o hera e o verbo fazem. Um
# projeto e um pod proprios (pod_peculio), separados dos outros, entao reiniciar um nao mexe
# no outro.
#
# As imagens a usar vem de ~/peculio/.env.imagens, escrito pelo deploy.
#
# Instalar em ~/.config/systemd/user/peculio-compose.service (o deploy faz isso) e habilitar:
#   systemctl --user daemon-reload
#   systemctl --user enable peculio-compose.service
# O linger do usuario ja esta ativo por causa do hera (loginctl enable-linger).

[Unit]
Description=Peculio (backend e frontend via podman-compose; o banco e o PostgreSQL compartilhado do infra-deck)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/peculio
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:%h/.local/bin
Environment=COMPOSE_PARALLEL_LIMIT=1
EnvironmentFile=-%h/peculio/.env.imagens
# O arquivo compose.vps.yml liga o backend ao banco compartilhado do infra-deck (ver o proprio arquivo)
ExecStart=%h/.local/bin/podman-compose -f docker-compose.yml -f deploy/compose.vps.yml up -d --no-build
ExecStop=%h/.local/bin/podman-compose -f docker-compose.yml -f deploy/compose.vps.yml down

[Install]
WantedBy=default.target
