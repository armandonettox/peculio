# Gerado a partir deste template quando o container sobe (${BACKEND_URL} vem do ambiente).
#
# O nome do backend e resolvido a cada requisicao, nao so quando o nginx sobe: em producao
# (podman-compose na VPS) os containers do mesmo pod nao compartilham rede, e se o backend
# reiniciar e ganhar outro IP, um proxy_pass fixo ficaria devolvendo 502 ate o frontend
# tambem reiniciar. NGINX_LOCAL_RESOLVERS e preenchida pela imagem a partir do
# /etc/resolv.conf do container (ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 no Dockerfile).
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # Nao mostra a versao do nginx nas respostas e nas paginas de erro
  server_tokens off;

  # Chamadas da API vao para o container do backend
  location /api/ {
    include /etc/nginx/security-headers.conf;
    # proxy_pass com variavel: o nginx resolve o nome em runtime (ver `resolver` acima)
    set $backend ${BACKEND_URL};
    proxy_pass $backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Sobrescreve o cabecalho com o IP de quem conectou. Nao usar $proxy_add_x_forwarded_for:
    # ele preserva o que o cliente mandou, e o cliente poderia forjar o IP e fugir do rate
    # limit. Se houver outro proxy na frente deste (Caddy, Traefik), o IP real passa a ser
    # o dele: ajustar aqui para repassar o cabecalho dele.
    proxy_set_header X-Forwarded-For $remote_addr;
  }

  # Contato de seguranca da instalacao (RFC 9116). O administrador define na tela de Configuracoes e o backend publica aqui.
  location = /.well-known/security.txt {
    include /etc/nginx/security-headers.conf;
    set $backend ${BACKEND_URL};
    proxy_pass $backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
  }

  # Arquivos com hash no nome (o Vite troca o nome quando o conteudo muda): podem ficar guardados para sempre
  location /assets/ {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # O service worker e o manifesto nunca podem ficar presos em cache: e por eles que uma versao nova chega ao
  # aparelho. O navegador ainda confere o service worker sozinho a cada 24 h, mas aqui ele confere sempre.
  location = /sw.js {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }

  location = /manifest.webmanifest {
    include /etc/nginx/security-headers.conf;
    default_type application/manifest+json;
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }

  # A pagina principal tambem confere com o servidor antes de usar a copia guardada
  location / {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
