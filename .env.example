# Copie para .env e ajuste. Nunca commite o .env
POSTGRES_USER=finance
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=finance

# Gere cada um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ENCRYPTION_KEY=

# "Manter conectado": o cookie de renovacao so viaja por HTTPS quando isto e true. Ligue assim que o Pecúlio estiver
# atras de HTTPS (proxy reverso com certificado). Em http://localhost deixe false, senao o navegador nao guarda o cookie.
# COOKIE_SECURE=false

# Porta do app no seu computador (padrao 8080). Troque se ela ja estiver em uso
# FRONTEND_PORT=8080

# Fuso horario do app (define o dia de hoje). Padrao: America/Sao_Paulo
# APP_TIMEZONE=America/Sao_Paulo

# Webhooks: por padrao so aceita https para enderecos publicos (protege a rede interna de SSRF).
# Mude para true so se o destino for um servico na sua rede (ex: Home Assistant em http://192.168.0.10)
# WEBHOOK_ALLOW_PRIVATE=false
# Por quantos dias guardar o historico de entregas de webhook ja finalizadas (entregue, falhou de
# vez ou expirada). Depois disso a linha e apagada. Entrega pendente nunca e apagada. Minimo 1.
# WEBHOOK_DELIVERY_RETENTION_DAYS=30
# WEBHOOK_INTERVAL_SECONDS=30
# Tamanho maximo de cada anexo de lancamento, em bytes (padrao 10 MB = 10485760).
# Os arquivos ficam no volume attachments_data (faca backup dele junto com o banco)
# ATTACHMENT_MAX_BYTES=10485760
